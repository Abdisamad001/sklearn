import numpy as np
import matplotlib.pyplot as plt

# Assuming sigmoid, softmax, get_loss, train_loader, W1, W2, b1, b2 are defined elsewhere
number_features = 10
num_images = 0
ls = []

lr = 0.001
for batch in train_loader:
    X, labels = batch
    X = X.numpy().reshape(-1, 28*28).T
    y = np.zeros((number_features, X.shape[1]))
    y[labels, np.arange(y.shape[1])] = 1

    # Forward pass
    Z1 = W1 @ X + b1
    A1 = sigmoid(Z1)
    Z2 = W2 @ A1 + b2
    A2 = softmax(Z2)

    # Compute loss and store
    loss = get_loss(A2, y)
    ls.append(loss)

    # Backward pass
    DrivitveZ2 = A2 - y
    DrivitveZ1 = (W2.T @ DrivitveZ2) * A1 * (1 - A1)

    SecondWeight2 = DrivitveZ2 @ A1.T
    SecondWeight1 = DrivitveZ1 @ X.T

    DrivtiveBias2 = np.sum(DrivitveZ2, axis=1, keepdims=True)
    DrivtiveBias1 = np.sum(DrivitveZ1, axis=1, keepdims=True)

    # Update parameters
    W1 -= lr * SecondWeight1
    W2 -= lr * SecondWeight2
    b1 -= lr * DrivtiveBias1
    b2 -= lr * DrivtiveBias2

    # Calculate classification error
    pred = np.argmax(A2, axis=0)
    if hasattr(labels, 'numpy'):  # Check if labels is a tensor
        labels = labels.numpy()
    correct = np.sum(labels == pred)
    total = A2.shape[1]
    error = total - correct
    num_images += total

    # Print accuracy
    print(f"Batch accuracy: {correct / total:.2f}")
    print(f"{error} out of {num_images} are incorrectly labeled")

# Plot the loss over iterations
plt.plot(range(len(ls)), ls)
plt.xlabel('Iteration')
plt.ylabel('Loss')
plt.title('Loss over iterations')
plt.show()






