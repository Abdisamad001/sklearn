#SEGMOID LOSS, SOFTMAX
def sigmoid(z):
  return 1/(1+np.exp(-z))


def get_loss(yhat, y):
    m = y.shape[1]
    loss = -np.sum(y * np.log(yhat + 1e-8)) / m  # 1e-8 added for numerical stability
    return loss



def softmax(z):
    exp_z = np.exp(z - np.max(z, axis=0, keepdims=True))
    return exp_z / np.sum(exp_z, axis=0, keepdims=True)

